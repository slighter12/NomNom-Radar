{
  "IMAGE_PLACEHOLDER": strenv(IMAGE),
  "SERVICE_ACCOUNT_PLACEHOLDER": strenv(RUNTIME_SA_EMAIL),
  "PROJECT_ID_PLACEHOLDER": strenv(PROJECT_ID),
  "HTTP_ALLOWEDHOST_PLACEHOLDER": strenv(ALLOWED_HOST),
  "HTTP_CORSALLOWEDORIGINS_PLACEHOLDER": strenv(CORS_ALLOWED_ORIGINS),
  "HTTP_RATELIMIT_ENABLED_PLACEHOLDER": strenv(RATE_LIMIT_ENABLED),
  "HTTP_RATELIMIT_RATE_PLACEHOLDER": strenv(RATE_LIMIT_RATE),
  "HTTP_RATELIMIT_BURST_PLACEHOLDER": strenv(RATE_LIMIT_BURST),
  "HTTP_RATELIMIT_EXPIRESIN_PLACEHOLDER": strenv(RATE_LIMIT_EXPIRES_IN),
  "GOOGLEOAUTH_CLIENTID_PLACEHOLDER": strenv(GOOGLE_OAUTH_CLIENT_ID),
  "RELEASE_SHA_PLACEHOLDER": strenv(RELEASE_SHA),
  "HTTP_CLOUDFLARESECRET_PLACEHOLDER": strenv(CLOUDFLARE_ORIGIN_SECRET)
} as $values |
# Reject multiline deployment values without displaying the input.
($values | to_entries | map(select(.value | test("[\r\n]"))) | length == 0) as $valid |
select($valid) |
(.. | select(tag == "!!str")) |= ($values[.] // .) |
(.. | select(tag == "!!str")) |= sub("PROJECT_NUMBER_PLACEHOLDER"; strenv(PROJECT_NUMBER)) |
# Also normalize older candidate templates to the current no-canary policy.
with(select(.kind == "Service"); .spec.traffic = [{"latestRevision": true, "percent": 100}])
